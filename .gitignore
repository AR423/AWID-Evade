# Dataset and raw captures (each member downloads their own copy)
data/
*.csv
*.pcap
*.pcapng

# Python / environment
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Proposal and other documents (kept local, not shared in the repo)
text/

# --- artifacts/: track only small, human-readable result files ---
# Ignore everything in artifacts/ by default (model binaries, scratch/debug runs, etc.)
artifacts/*

# Keep the piece-scan summary (small, useful for the report)
!artifacts/piece_labels.csv

# Keep only the canonical baseline run folder; any other run_*/debug folder stays ignored
!artifacts/baseline/
artifacts/baseline/*
!artifacts/baseline/*.json
!artifacts/baseline/*.csv

# --- artifacts/attack/ and artifacts/defense/: same pattern as baseline/ ---
!artifacts/attack/
artifacts/attack/*
!artifacts/attack/*.json
!artifacts/attack/*.csv

!artifacts/defense/
artifacts/defense/*
!artifacts/defense/*.json

# --- artifacts/problem_space/: the two recaptured pcaps are deliberate exceptions
# (small, real hardware-run evidence) to the blanket *.pcap rule above, plus the
# metrics writeup, same pattern as baseline/attack/defense ---
!artifacts/problem_space/
artifacts/problem_space/*
!artifacts/problem_space/*.json
!artifacts/problem_space/*.pcap