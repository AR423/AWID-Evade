# Dataset and raw captures (each member downloads their own copy)
data/
*.csv
*.pcap
*.pcapng

# Python / environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Proposal and other documents (kept local, not shared in the repo)
text/

# --- artifacts/: track only small, human-readable result files ---
# Ignore everything in artifacts/ by default (model binaries, scratch/debug runs, etc.)
artifacts/*

# Keep the piece-scan summary (small, useful for the report)
!artifacts/piece_labels.csv

# Keep only the canonical baseline run folder; any other run_*/debug folder stays ignored
!artifacts/baseline/
artifacts/baseline/*
!artifacts/baseline/*.json
!artifacts/baseline/*.csv
venv/
